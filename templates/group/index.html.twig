{% extends 'base.html.twig' %}

{% block title %}Groups Management{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/harvard.css') }}">

<div class="harvard-layout">
    <!-- SIDEBAR -->
    <aside class="harvard-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI">
            <span>Admin</span>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_admin') }}">Dashboard</a>
            <a href="{{ path('app_user_index') }}">Users & Roles</a>
            <a href="{{ path('app_group_index') }}" class="active">Groups</a>
            <a href="{{ path('app_student_group_index') }}">Student Groups</a>
            <a href="{{ path('app_reports') }}">Reports</a>
            <a href="{{ path('app_system_settings') }}">System Settings</a>
            <a href="{{ path('app_audit_logs') }}">Audit Logs</a>
        </nav>
        <div class="sidebar-footer">
            <a href="{{ path('app_logout') }}">Logout</a>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="harvard-main">
        <header class="harvard-topbar">
            <h1>Groups Management</h1>
            <div class="harvard-user">
                <span>{{ app.user.userIdentifier }}</span>
            </div>
        </header>

        <section class="harvard-section">
            <div class="section-header">
                <h2>All Groups</h2>
                <a href="{{ path('app_group_new') }}" class="btn-primary">+ Create Group</a>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Year</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for group in groups %}
                    <tr>
                        <td>{{ group.id }}</td>
                        <td>{{ group.name }}</td>
                        <td>{{ group.year }}</td>
                        <td>
                            <a href="{{ path('app_group_show', {'id': group.id}) }}" class="btn-small">View</a>
                            <a href="{{ path('app_group_edit', {'id': group.id}) }}" class="btn-small">Edit</a>
                            <form method="POST" action="{{ path('app_group_delete', {'id': group.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ group.id) }}">
                                <button type="submit" class="btn-small danger" onclick="return confirm('Delete this group?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" style="text-align:center; padding:20px;">No groups found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
</div>
{% endblock %}



