{{ form_start(form) }}
    <div class="form-group">
        {{ form_label(form.name, 'Group Name') }}
        {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'e.g. 1A'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="form-group">
        {{ form_label(form.year, 'Year') }}
        {{ form_widget(form.year, {'attr': {'class': 'form-control', 'placeholder': 'e.g. 2026'}}) }}
        {{ form_errors(form.year) }}
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-primary">{{ button_label|default('Save') }}</button>
        <a href="{{ path('app_group_index') }}" class="btn-secondary">Cancel</a>
    </div>
{{ form_end(form) }}



