{% extends 'base.html.twig' %}

{% block title %}Lessons | EMSI{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/harvard.css') }}">

<div class="harvard-layout">

    <aside class="harvard-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI">
            <span>EMSI</span>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_teacher') }}">Dashboard</a>
            <a href="{{ path('app_course_index') }}">My Courses</a>
            <a href="{{ path('app_student_group_index') }}">Manage Students</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        </nav>
    </aside>

    <main class="harvard-main">
        <header class="harvard-topbar">
            <h1>Lessons - {{ course.title }}</h1>
        </header>

        <section class="harvard-section">
            <div class="section-header">
                <h2>Course Materials</h2>
                <a href="{{ path('app_lesson_new', {'courseId': course.id}) }}" class="btn-primary">+ Add Lesson</a>
            </div>

            {% if lessons %}
                <table class="table">
                    <thead>
                        <tr>
                            <th>Lesson Title</th>
                            <th>Material</th>
                            <th>Deadline</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for lesson in lessons %}
                            <tr>
                                <td><strong>{{ lesson.title }}</strong></td>
                                <td>
                                    {% if lesson.pdfFile %}
                                        <a href="{{ asset('uploads/lessons/' ~ lesson.pdfFile) }}" target="_blank" class="badge info">📄 Download PDF</a>
                                    {% else %}
                                        <span class="badge warning">No file</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if lesson.deadline %}
                                        {{ lesson.deadline|date('M d, Y H:i') }}
                                        {% if lesson.isOverdue() %}
                                            <span class="badge danger">Overdue</span>
                                        {% endif %}
                                    {% else %}
                                        <span style="color: #7f8c8d;">No deadline</span>
                                    {% endif %}
                                </td>
                                <td>{{ lesson.createdAt|date('M d, Y') }}</td>
                                <td>
                                    <a href="{{ path('app_lesson_edit', {'id': lesson.id}) }}" class="btn-small">Edit</a>
                                    <form method="POST" action="{{ path('app_lesson_delete', {'id': lesson.id}) }}" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ lesson.id) }}">
                                        <button type="submit" class="btn-small btn-danger" onclick="return confirm('Delete this lesson?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="empty-state">
                    <p>No lessons created yet for this course.</p>
                    <p><a href="{{ path('app_lesson_new', {'courseId': course.id}) }}">Create your first lesson</a></p>
                </div>
            {% endif %}
        </section>

        <div style="margin-top: 20px; padding: 0 40px;">
            <a href="{{ path('app_course_index') }}" class="btn-secondary">← Back to Courses</a>
        </div>

    </main>
</div>
{% endblock %}
