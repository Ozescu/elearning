{% extends 'base.html.twig' %}

{% block title %}Edit Lesson | EMSI{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/harvard.css') }}">

<div class="harvard-layout">

    <aside class="harvard-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI">
            <span>EMSI</span>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_teacher') }}">Dashboard</a>
            <a href="{{ path('app_course_index') }}">My Courses</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        </nav>
    </aside>

    <main class="harvard-main">
        <header class="harvard-topbar">
            <h1>Edit Lesson: {{ lesson.title }}</h1>
        </header>

        <section class="harvard-section">
            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.pdf_file) }}
                    {{ form_widget(form.pdf_file) }}
                    {% if lesson.pdfFile %}
                        <small style="color: #6b7280;">Current: <a href="{{ asset('uploads/lessons/' ~ lesson.pdfFile) }}" target="_blank">{{ lesson.pdfFile }}</a></small>
                    {% endif %}
                </div>

                <div class="form-group">
                    {{ form_label(form.deadline) }}
                    {{ form_widget(form.deadline) }}
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Update Lesson</button>
                    <a href="{{ path('app_lesson_index', {'courseId': lesson.course.id}) }}" class="btn-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </section>

    </main>
</div>
{% endblock %}
