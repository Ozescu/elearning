{% extends 'base.html.twig' %}

{% block title %}Create Lesson | EMSI{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/harvard.css') }}">

<div class="harvard-layout">

    <aside class="harvard-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI">
            <span>EMSI</span>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_teacher') }}">Dashboard</a>
            <a href="{{ path('app_course_index') }}">My Courses</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        </nav>
    </aside>

    <main class="harvard-main">
        <header class="harvard-topbar">
            <h1>Create New Lesson</h1>
        </header>

        <section class="harvard-section">
            <div class="form-container">
                {{ form_start(form) }}
                
                <div class="form-group">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title, {'attr': {'placeholder': 'e.g., Introduction to Biology', 'class': 'form-control'}}) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {'attr': {'placeholder': 'Lesson description', 'rows': 4, 'class': 'form-control'}}) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.pdf_file, 'Upload PDF Material') }}
                    {{ form_widget(form.pdf_file, {'attr': {'class': 'form-control'}}) }}
                    <small style="color: #7f8c8d;">Upload a PDF file for this lesson</small>
                </div>

                <div class="form-group">
                    {{ form_label(form.deadline) }}
                    {{ form_widget(form.deadline, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Create Lesson</button>
                    <a href="{{ path('app_course_index') }}" class="btn-secondary">Cancel</a>
                </div>

                {{ form_end(form) }}
            </div>
        </section>

    </main>
</div>
{% endblock %}
                    <a href="{{ path('app_lesson_index', {'courseId': course.id}) }}" class="btn-secondary">Cancel</a>
                </div>
            {{ form_end(form) }}
        </section>

    </main>
</div>
{% endblock %}
