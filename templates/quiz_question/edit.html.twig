{% extends 'base.html.twig' %}

{% block title %}Edit Question | EMSI{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/harvard.css') }}">

<div class="harvard-layout">

    <aside class="harvard-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI">
            <span>Teacher</span>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_teacher') }}">Dashboard</a>
            <a href="{{ path('app_course_index') }}">My Courses</a>
            <a href="{{ path('app_student_group_index') }}">Manage Students</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        </nav>
    </aside>

    <main class="harvard-main">
        <header class="harvard-topbar">
            <h1>Edit Question</h1>
        </header>

        <section class="harvard-section">
            <div class="form-container">
                {{ form_start(form) }}
                
                <div class="form-group">
                    {{ form_label(form.question, 'Question Text') }}
                    {{ form_widget(form.question, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.questionType, 'Question Type') }}
                    {{ form_widget(form.questionType, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="form-group" id="options-group" style="display: none;">
                    {{ form_label(form.options, 'Options') }}
                    {{ form_widget(form.options, {'attr': {'class': 'form-control', 'placeholder': 'A: First option' ~ "\n" ~ 'B: Second option'}}) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.correctAnswer, 'Correct Answer') }}
                    {{ form_widget(form.correctAnswer, {'attr': {'class': 'form-control', 'placeholder': 'Enter the correct answer'}}) }}
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Update Question</button>
                    <a href="{{ path('app_quiz_edit', {'id': quiz.id}) }}" class="btn-secondary">Cancel</a>
                </div>

                {{ form_end(form) }}
            </div>
        </section>

    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const typeSelect = document.querySelector('[name="quiz_question[questionType]"]');
    const optionsGroup = document.getElementById('options-group');
    
    function toggleOptionsField() {
        if (typeSelect.value === 'multiple_choice') {
            optionsGroup.style.display = 'block';
        } else {
            optionsGroup.style.display = 'none';
        }
    }
    
    typeSelect.addEventListener('change', toggleOptionsField);
    toggleOptionsField(); // Initial check
});
</script>
{% endblock %}
