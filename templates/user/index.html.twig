{% extends 'base.html.twig' %}

{% block title %}Users & Roles Management{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/harvard.css') }}">

<div class="harvard-layout">
    <aside class="harvard-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI">
            <span>Admin</span>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_admin') }}">Dashboard</a>
            <a href="{{ path('app_user_index') }}" class="active">Users & Roles</a>
            <a href="{{ path('app_group_index') }}">Groups</a>
            <a href="{{ path('app_student_group_index') }}">Student Groups</a>
            <a href="{{ path('app_reports') }}">Reports</a>
            <a href="{{ path('app_system_settings') }}">System Settings</a>
            <a href="{{ path('app_audit_logs') }}">Audit Logs</a>
        </nav>
        <div class="sidebar-footer">
            <a href="{{ path('app_logout') }}">Logout</a>
        </div>
    </aside>

    <main class="harvard-main">
        <header class="harvard-topbar">
            <h1>Users & Roles Management</h1>
            <div class="harvard-user">
                <span>{{ app.user.userIdentifier }}</span>
            </div>
        </header>

        <section class="harvard-section">
            <div class="section-header">
                <h2>All Users</h2>
                <a href="{{ path('app_user_new') }}" class="btn-primary">+ Create User</a>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Approved</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% for role in user.roles %}
                                <span class="badge role-badge">{{ role|replace({'ROLE_': ''}) }}</span>
                            {% endfor %}
                        </td>
                        <td><span class="badge {% if user.isApproved %}success{% else %}warning{% endif %}">{{ user.isApproved ? 'Yes' : 'No' }}</span></td>
                        <td>{{ user.createdAt ? user.createdAt|date('Y-m-d') : '—' }}</td>
                        <td>
                            <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn-small">View</a>
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn-small">Edit</a>
                            <form method="POST" action="{{ path('app_user_delete', {'id': user.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button type="submit" class="btn-small danger" onclick="return confirm('Delete this user?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align:center; padding:20px;">No users found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
</div>

<style>
    .role-badge {
        background-color: #e7f3ff;
        color: #0066cc;
        font-size: 11px;
        margin-right: 4px;
    }
</style>
{% endblock %}



