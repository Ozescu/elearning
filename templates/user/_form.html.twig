{{ form_start(form) }}
    <div class="form-group">
        {{ form_label(form.email, 'Email Address') }}
        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'user@example.com'}}) }}
        {{ form_errors(form.email) }}
    </div>

    <div class="form-group">
        {{ form_label(form.password, 'Password') }}
        {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Leave blank to keep current'}}) }}
        {{ form_errors(form.password) }}
    </div>

    <div class="form-group">
        {{ form_label(form.roles, 'Assign Roles') }}
        <div class="role-checkboxes">
            {{ form_widget(form.roles) }}
        </div>
        {{ form_errors(form.roles) }}
    </div>

    <div class="form-group">
        {{ form_label(form.is_approved, 'Approved') }}
        {{ form_widget(form.is_approved, {'attr': {'class': 'form-checkbox'}}) }}
        {{ form_errors(form.is_approved) }}
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-primary">{{ button_label|default('Save') }}</button>
        <a href="{{ path('app_user_index') }}" class="btn-secondary">Cancel</a>
    </div>
{{ form_end(form) }}

<style>
    .role-checkboxes {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 10px;
    }
    
    .role-checkboxes label {
        display: flex;
        align-items: center;
        font-weight: normal;
    }
    
    .role-checkboxes input[type="checkbox"] {
        margin-right: 8px;
    }
</style>



