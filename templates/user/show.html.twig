{% extends 'base.html.twig' %}

{% block title %}View User{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/harvard.css') }}">

<div class="harvard-layout">
    <aside class="harvard-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI">
            <span>Admin</span>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_admin') }}">Dashboard</a>
            <a href="{{ path('app_user_index') }}" class="active">Users & Roles</a>
            <a href="{{ path('app_group_index') }}">Groups</a>
            <a href="{{ path('app_student_group_index') }}">Student Groups</a>
            <a href="{{ path('app_reports') }}">Reports</a>
            <a href="{{ path('app_system_settings') }}">System Settings</a>
            <a href="{{ path('app_audit_logs') }}">Audit Logs</a>
        </nav>
        <div class="sidebar-footer">
            <a href="{{ path('app_logout') }}">Logout</a>
        </div>
    </aside>

    <main class="harvard-main">
        <header class="harvard-topbar">
            <h1>User Details</h1>
        </header>
        <section class="harvard-section">
            <div class="detail-view">
                <div class="detail-item">
                    <label>ID:</label>
                    <span>{{ user.id }}</span>
                </div>
                <div class="detail-item">
                    <label>Email:</label>
                    <span>{{ user.email }}</span>
                </div>
                <div class="detail-item">
                    <label>Roles:</label>
                    <span>
                        {% for role in user.roles %}
                            <span class="badge role-badge">{{ role|replace({'ROLE_': ''}) }}</span>
                        {% endfor %}
                    </span>
                </div>
                <div class="detail-item">
                    <label>Approved:</label>
                    <span>{{ user.isApproved ? 'Yes' : 'No' }}</span>
                </div>
                <div class="detail-item">
                    <label>Created:</label>
                    <span>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '—' }}</span>
                </div>
            </div>
            <div class="form-actions" style="margin-top:20px;">
                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn-primary">Edit</a>
                <a href="{{ path('app_user_index') }}" class="btn-secondary">Back to List</a>
            </div>
        </section>
    </main>
</div>

<style>
    .role-badge {
        background-color: #e7f3ff;
        color: #0066cc;
        font-size: 11px;
        margin-right: 4px;
    }
</style>
{% endblock %}



