{% extends 'base.html.twig' %}

{% block title %}Create Announcement | EMSI{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/harvard.css') }}">

<div class="harvard-layout">

    <aside class="harvard-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI">
            <span>Admin</span>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_admin') }}">Dashboard</a>
            <a href="{{ path('app_announcement_index') }}" class="active">Announcements</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        </nav>
    </aside>

    <main class="harvard-main">
        <header class="harvard-topbar">
            <h1>Create Announcement</h1>
        </header>

        <section class="harvard-section">
            <div class="form-container">
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="form-actions">
                        <button type="submit" class="btn-primary">Create Announcement</button>
                        <a href="{{ path('app_announcement_index') }}" class="btn-secondary">Cancel</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </section>

    </main>
</div>
{% endblock %}
