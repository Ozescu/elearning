{% extends 'base.html.twig' %}

{% block title %}EMSI | Sign in{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/login.css') }}">

<section class="login-page">

    <div class="login-container">

        <!-- LEFT SIDE (Brand / Academic) -->
        <div class="login-left">
            <!-- replace with emsi-logo.svg -->
            <img src="{{ asset('images/emsi.png') }}" alt="EMSI Logo" class="login-logo">

            <h1>EMSI E-Learning</h1>
            <p>
                Access the official digital learning platform for
                EMSI engineering students and faculty.
            </p>

            <!-- optional image -->
            <!-- <img src="{{ asset('images/login-campus.jpg') }}" class="login-image"> -->
        </div>

        <!-- RIGHT SIDE (FORM) -->
        <div class="login-right">

            <h2>Sign in</h2>
            <p class="login-subtext">Use your institutional account</p>

            {% if error %}
                <div class="login-error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="login-info">
                    You are logged in as <strong>{{ app.user.userIdentifier }}</strong>.
                    <a href="{{ logout_path() }}">Logout</a>
                </div>
            {% endif %}

            <form method="post" data-turbo="false" class="login-form">

                <div class="form-group">
                    <label for="inputEmail">Email address</label>
                    <input
                        type="email"
                        id="inputEmail"
                        name="_username"
                        value="{{ last_username }}"
                        autocomplete="username"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="inputPassword">Password</label>
                    <input
                        type="password"
                        id="inputPassword"
                        name="_password"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                <div class="form-options">
                    <label class="remember">
                        <input type="checkbox" name="_remember_me">
                        Remember me
                    </label>
                </div>

                <button type="submit" class="btn-login">
                    Sign in
                </button>

            </form>

            <p class="login-footer">
                © {{ "now"|date("Y") }} EMSI — École Marocaine des Sciences de l’Ingénierie
            </p>

        </div>

    </div>

</section>
{% endblock %}



